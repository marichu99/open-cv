FLASK_ENV=development
# DEBUG also exposes OTP codes in API responses (see services/otp.py) as a
# fallback when SMTP isn't configured. Off by default — fill in SMTP_* below
# and OTPs are emailed for real; only flip this on if you need the shortcut.
DEBUG=false
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg2://tally333:tally333@localhost:5432/tally333
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=instance/uploads
# mock = deterministic fake data, no API key needed, used by tests/local dev.
# claude = real extraction via Claude Vision (app/services/claude_vision.py) —
# needs ANTHROPIC_API_KEY below, and every upload becomes a billed API call.
CV_BACKEND=mock
CONFIDENCE_THRESHOLD=0.85
ANTHROPIC_API_KEY=

# OTP delivery over SMTP (see app/services/email.py). If left blank, OTPs
# still work via server logs — set DEBUG=true above to also see them in the API response.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
